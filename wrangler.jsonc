{
  // Static site on Cloudflare Workers: no server code, just the files in
  // public/. `npx wrangler deploy` uploads them; pushes to main redeploy.
  "name": "bugsmetwice",
  "compatibility_date": "2026-09-01",
  // bugsmetwice.com is the only address: no *.workers.dev or preview hostnames
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
